      "kind": "card",
      "refersTo": "card",
      "description": "Factual white card with fine tonal separation.",
      "html": "<section class=\"ds-card\"><h3 class=\"ds-card-title\">Observed transfers</h3><p class=\"ds-card-description\">Recorded account activity</p><p class=\"ds-card-body\">Inspect the evidence supporting this hypothesis.</p></section>",
      "css": ".ds-card{width:280px;padding:16px;border-radius:1rem;background:var(--card);color:var(--card-foreground);box-shadow:0 0 0 1px var(--border);font:400 14px/20px \"Inter Variable\",sans-serif}.ds-card-title{margin:0;font-size:16px;line-height:24px;font-weight:500}.ds-card-description{margin:4px 0 16px;color:var(--muted-foreground)}.ds-card-body{margin:0}"
    },
