      "html": "<button class=\"ds-button\">Inspect account</button>",
      "css": ".ds-button{font-family:\"Inter Variable\",sans-serif;font-size:15px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border:1px solid transparent;border-radius:var(--radius-lg,.75rem);cursor:pointer;transition:background-color 150ms;}.ds-button{background:transparent;color:var(--foreground);}.ds-button:hover{background:var(--muted)}.ds-button:focus-visible{outline:0;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}.ds-button:active{transform:translateY(1px)}.ds-button:disabled{pointer-events:none;opacity:.5}@media(pointer:coarse){.ds-button{min-height:44px}}"
