      "css": ".ds-button{font-family:\"Inter Variable\",sans-serif;font-size:15px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;height:40px;padding:0 16px;border:1px solid transparent;border-radius:var(--radius-lg,1rem);cursor:pointer;transition:background-color 150ms;}.ds-button{background:var(--primary);color:var(--primary-foreground);}.ds-button:hover{background:color-mix(in oklch,var(--primary) 80%,transparent)}.ds-button:focus-visible{outline:0;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}.ds-button:active{transform:translateY(1px)}.ds-button:disabled{pointer-events:none;opacity:.5}@media(pointer:coarse){.ds-button{min-height:44px}}"
