    {
      "name": "Account Search",
      "kind": "input",
      "refersTo": "input",
      "description": "Compact account lookup with a visible dark-green focus ring.",
      "html": "<label class=\"ds-label\" for=\"ds-account\">Account ID</label><input class=\"ds-input\" id=\"ds-account\" placeholder=\"Jump to account…\" />",
      "css": ".ds-label{display:block;margin-bottom:8px;font:500 14px \"Inter Variable\",sans-serif;color:var(--foreground)}.ds-input{font:400 16px \"Inter Variable\",sans-serif;height:40px;width:240px;padding:4px 10px;background:transparent;color:var(--foreground);border:1px solid var(--input);border-radius:var(--radius-lg,.75rem);transition:color 150ms,border-color 150ms}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:0;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring) 50%,transparent)}.ds-input:disabled{opacity:.5;pointer-events:none;background:color-mix(in oklch,var(--input) 50%,transparent)}@media(min-width:768px){.ds-input{font-size:15px}}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "32px desktop navigation, soft hover and charcoal selection; 44px mobile targets.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button class=\"ds-nav-item\" aria-current=\"page\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"16\" aria-hidden=\"true\"><path d=\"M32 32h80v80H32zM144 32h80v80h-80zM32 144h80v80H32zM144 144h80v80h-80z\"/></svg>Overview</button><button class=\"ds-nav-item\">Investigation</button></nav>",
      "css": ".ds-nav{width:240px;padding:8px;background:var(--sidebar)}.ds-nav-item{font-family:\"Inter Variable\",sans-serif;font-size:14px;font-weight:400;display:flex;gap:8px;align-items:center;width:100%;height:32px;padding:8px;border:0;border-radius:var(--radius-md,.6rem);background:transparent;color:var(--sidebar-foreground);cursor:pointer;transition:background-color 160ms cubic-bezier(.23,1,.32,1)}.ds-nav-item:hover{background:var(--sidebar-accent);color:var(--sidebar-accent-foreground)}.ds-nav-item[aria-current=page],.ds-nav-item[aria-current=page]:hover{background:var(--sidebar-primary);color:var(--sidebar-primary-foreground);font-weight:500}.ds-nav-item:focus-visible{outline:2px solid var(--sidebar-ring);outline-offset:2px}@media(max-width:767px){.ds-nav-item{min-height:44px;padding-inline:12px}.ds-nav-item+.ds-nav-item{margin-top:4px}}"
    },
