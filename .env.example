# Copy to .env. Never commit credentials or organizer data.
# Leave unset for the generated synthetic demo dataset.
# MONEYGRAPH_DATA_DIR=/absolute/path/to/organizer/data
MONEYGRAPH_OUTPUT_DIR=outputs
# AI is optional. The complete graph workflow works without a subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
MONEYGRAPH_AI_ENABLED=false
# Explicitly opt in before sending bounded graph evidence to OpenAI.
MONEYGRAPH_ALLOW_EXTERNAL_AI=false
