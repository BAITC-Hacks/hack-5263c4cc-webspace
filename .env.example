# Copy to .env. Never commit credentials or organizer data.
# Leave unset for the generated synthetic demo dataset.
# MONEYGRAPH_DATA_DIR=/absolute/path/to/organizer/data
MONEYGRAPH_OUTPUT_DIR=outputs
# AI is optional. The complete graph workflow works without a subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
MONEYGRAPH_AI_ENABLED=false
# Explicitly opt in before sending bounded graph evidence to OpenAI.
MONEYGRAPH_ALLOW_EXTERNAL_AI=false
# Local request budgets are per process. The per-minute count is also the burst.
# Keep the server on loopback; these limits do not add user authentication.
MONEYGRAPH_API_PER_MINUTE=240
MONEYGRAPH_API_GLOBAL_PER_MINUTE=1200
MONEYGRAPH_COPILOT_PER_MINUTE=12
MONEYGRAPH_COPILOT_GLOBAL_PER_MINUTE=30
# Bound actual body bytes, including requests without Content-Length.
MONEYGRAPH_MAX_BODY_BYTES=98304
# Conversation memory is bounded and expires after 24 hours (128 sessions).
# Default: process memory only. Optional SQLite persists private case context
# across restarts; keep this path outside Git and delete it when no longer needed.
# MONEYGRAPH_MEMORY_PATH=.private/copilot-memory.sqlite3
